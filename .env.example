# ============================================
# Iara Dropship SaaS - Variáveis de Ambiente
# ============================================

# Servidor
PORT=3000
NODE_ENV=production
JWT_SECRET=sua_chave_jwt_secreta_aqui

# PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/dropship_saas

# Redis
REDIS_URL=redis://localhost:6379

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=seu_access_token_mercadopago
MERCADOPAGO_PUBLIC_KEY=sua_public_key_mercadopago
MERCADOPAGO_WEBHOOK_SECRET=seu_webhook_secret

# WhatsApp Business API
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_TOKEN=seu_token_whatsapp
WHATSAPP_PHONE_ID=seu_phone_number_id
WHATSAPP_VERIFY_TOKEN=seu_verify_token

# URLs
APP_URL=https://seu-dominio.com
WEBHOOK_URL=https://seu-dominio.com/api/webhooks/mercadopago

# Looker Studio (exportação de dados)
LOOKER_EXPORT_ENABLED=true
